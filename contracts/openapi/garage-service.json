      "CreateFavoriteResource": {
        "required": [
          "vehicleId"
        ],
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "integer",
            "description": "Positive ID of an existing vehicle",
            "format": "int64",
            "example": 1
          },
          "userId": {
            "type": "string",
            "description": "Optional account ID; must match the authenticated account",
            "example": "1"
          },
          "notes": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Optional personal notes, up to 500 characters"
          }
        },
        "description": "Existing vehicle to save as a favorite for the authenticated user, with optional personal notes."
      },
      "FavoriteResource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Favorite ID used when deleting the favorite",
            "example": "1"
          },
          "userId": {
            "type": "string",
            "description": "Owner's account ID",
            "example": "1"
          },
          "vehicleId": {
            "type": "string",
            "description": "Saved vehicle ID",
            "example": "7"
          },
          "addedAt": {
            "type": "string",
            "description": "Server timestamp at which the favorite was saved",
            "format": "date-time"
          },
          "notes": {
            "maxLength": 500,
            "type": "string",
