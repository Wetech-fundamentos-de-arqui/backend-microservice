# Copy to .env (git-ignored) and replace every change-me. Nothing here is a real secret.

# --- MySQL (ADR-006): root + one password per service schema -----------------------------------
MYSQL_ROOT_PASSWORD=change-me
DB_PASSWORD_IAM=change-me
DB_PASSWORD_PROFILE=change-me
DB_PASSWORD_GARAGE=change-me
DB_PASSWORD_LOCATION=change-me
DB_PASSWORD_BOOKING=change-me
DB_PASSWORD_RIDE=change-me
DB_PASSWORD_PLAN=change-me
DB_PASSWORD_NOTIFICATION=change-me

# --- JWT keys (ADR-004): PEM files outside the repo (see README, "Claves JWT locales") ----------
# Public key: gateway and every service. Private key: iam-service only.
JWT_PUBLIC_KEY_FILE=./secrets/jwt-public.pem
JWT_PRIVATE_KEY_FILE=./secrets/jwt-private.pem

# --- Gateway ----------------------------------------------------------------------------------
# Exact list, comma separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:4200,https://weride.duckdns.org,https://frontend-we-ride-lake.vercel.app,https://weride-frontend.vercel.app,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085,http://localhost:8086,http://localhost:8087,http://localhost:8088

# --- Internal service-to-service secrets (ADR-004): one per caller -> receiver pair -------------
# The receiver stores it in weride.internal.callers.<caller>, the caller in weride.internal.targets.<receiver>.secret.
INTERNAL_SECRET_API_GATEWAY_TO_IAM=change-me
INTERNAL_SECRET_IAM_TO_BOOKING=change-me
INTERNAL_SECRET_IAM_TO_PROFILE=change-me
INTERNAL_SECRET_IAM_TO_GARAGE=change-me
INTERNAL_SECRET_IAM_TO_RIDE=change-me
INTERNAL_SECRET_IAM_TO_NOTIFICATION=change-me
INTERNAL_SECRET_BOOKING_TO_RIDE=change-me
INTERNAL_SECRET_BOOKING_TO_GARAGE=change-me
INTERNAL_SECRET_BOOKING_TO_LOCATION=change-me
INTERNAL_SECRET_BOOKING_TO_NOTIFICATION=change-me
INTERNAL_SECRET_RIDE_TO_BOOKING=change-me
INTERNAL_SECRET_RIDE_TO_GARAGE=change-me
INTERNAL_SECRET_RIDE_TO_NOTIFICATION=change-me
